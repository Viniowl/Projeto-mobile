// Este arquivo é o "coração" do seu banco de dados.
// Ele define a estrutura de todas as tabelas, seus campos e como elas se relacionam.
// O Prisma usa este arquivo para gerar o código de acesso ao banco de dados (Prisma Client).

// Define o gerador de cliente, que criará o código TypeScript para interagir com o banco de dados.
generator client {
  provider = "prisma-client-js"
}

// Configura a conexão com o banco de dados.
// Neste caso, é um banco PostgreSQL, e a URL de conexão está em uma variável de ambiente.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo "User": Representa um usuário (cliente) cadastrado no sistema.
model Usuario {
  id           String   @id @default(uuid()) // Chave primária única (UUID).
  nome         String   // Nome do usuário.
  telefone     String   @unique // Telefone para contato, deve ser único para cada usuário.
  senha        String   // Senha do usuário (deve ser armazenada de forma criptografada).
  endereco     String?  // Endereço do usuário, opcional (?).
  criadoEm     DateTime @default(now()) // Data e hora de criação do registro.
  atualizadoEm DateTime @updatedAt // Data e hora da última atualização do registro.

  // Relação: Um usuário pode ter vários pedidos (Orders).
  pedidos   Pedido[]
}

// Modelo "Category": Representa as categorias dos produtos (ex: "Pastéis Salgados", "Bebidas").
model Categoria {
  id      String    @id @default(uuid())
  nome    String    @unique // Nome da categoria (ex: "Bebidas"), deve ser único.
  
  // Relação: Uma categoria pode conter vários produtos.
  produtos Produto[]
}

// Modelo "Produto": Representa um item que pode ser vendido (ex: "Pastel de Carne", "Coca-Cola").
model Produto {
  id          String      @id @default(uuid())
  nome        String      @unique // Nome do produto, deve ser único.
  preco      Float       // Preço do produto.
  
  // Relação: Um produto pertence a uma categoria.
  categoria    Categoria    @relation(fields: [categoriaId], references: [id])
  categoriaId  String      // Chave estrangeira para o modelo Category.

  // Relação: Um produto pode estar em vários itens de pedido.
  itensPedido  ItemPedido[]
}

// Modelo "Pedido": Representa um pedido feito por um usuário.
model Pedido {
  id        String      @id @default(uuid())
  criadoEm  DateTime    @default(now()) // Data e hora em que o pedido foi feito.
  status    String      @default("PENDENTE") // Status do pedido (ex: PENDENTE, CONCLUÍDO, CANCELADO).
  total     Float       // Valor total do pedido.

  // Relação: Um pedido pertence a um único usuário.
  usuario     Usuario        @relation(fields: [usuarioId], references: [id])
  usuarioId   String      // Chave estrangeira para o modelo Usuario.

  // Relação: Um pedido é composto por vários itens.
  itens     ItemPedido[]
}

// Modelo "OrderItem": Representa um item específico dentro de um pedido.
// Ex: 2 unidades do "Pastel de Queijo" dentro do Pedido #123.
model ItemPedido {
  id           String  @id @default(uuid())
  quantidade   Int     // Quantidade deste item no pedido.
  preco        Float   // Preço do produto no momento da compra (para histórico).
  nomeProduto  String @default("Produto Desconhecido") // Nome do produto no momento da compra.
  nomeUsuario  String  @default("Usuário Desconhecido") // Nome do usuário que fez o pedido.

  // Relação: Este item de pedido pertence a um pedido (Pedido).
  pedido     Pedido   @relation(fields: [pedidoId], references: [id])
  pedidoId   String  // Chave estrangeira para o modelo Pedido.

  // Relação: Este item de pedido refere-se a um produto (Product).
  produto   Produto @relation(fields: [produtoId], references: [id])
  produtoId String  // Chave estrangeira para o modelo Produto.
}