// Este arquivo é o "coração" do seu banco de dados.
// Ele define a estrutura de todas as tabelas, seus campos e como elas se relacionam.
// O Prisma usa este arquivo para gerar o código de acesso ao banco de dados (Prisma Client).

// Define o gerador de cliente, que criará o código TypeScript para interagir com o banco de dados.
generator client {
  provider = "prisma-client-js"
}

// Configura a conexão com o banco de dados.
// Neste caso, é um banco PostgreSQL, e a URL de conexão está em uma variável de ambiente.
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Modelo "User": Representa um usuário (cliente) cadastrado no sistema.
model User {
  id        String   @id @default(uuid()) // Chave primária única (UUID).
  name      String   // Nome do usuário.
  telefone  String   @unique // Telefone para contato, deve ser único para cada usuário.
  password  String   // Senha do usuário (deve ser armazenada de forma criptografada).
  endereco  String?  // Endereço do usuário, opcional (?).
  createdAt DateTime @default(now()) // Data e hora de criação do registro.
  updatedAt DateTime @updatedAt // Data e hora da última atualização do registro.

  // Relação: Um usuário pode ter vários pedidos (Orders).
  orders    Order[]
}

// Modelo "Category": Representa as categorias dos produtos (ex: "Pastéis Salgados", "Bebidas").
model Category {
  id       String    @id @default(uuid())
  name     String    @unique // Nome da categoria (ex: "Bebidas"), deve ser único.
  
  // Relação: Uma categoria pode conter vários produtos.
  products Product[]
}

// Modelo "Product": Representa um item que pode ser vendido (ex: "Pastel de Carne", "Coca-Cola").
model Product {
  id          String      @id @default(uuid())
  name        String      @unique // Nome do produto, deve ser único.
  price       Float       // Preço do produto.
  
  // Relação: Um produto pertence a uma categoria.
  category    Category    @relation(fields: [categoryId], references: [id])
  categoryId  String      // Chave estrangeira para o modelo Category.

  // Relação: Um produto pode estar em vários itens de pedido (OrderItems).
  orderItems  OrderItem[]
}

// Modelo "Order": Representa um pedido feito por um usuário.
model Order {
  id        String      @id @default(uuid())
  createdAt DateTime    @default(now()) // Data e hora em que o pedido foi feito.
  status    String      @default("PENDING") // Status do pedido (ex: PENDENTE, CONCLUÍDO, CANCELADO).
  total     Float       // Valor total do pedido.

  // Relação: Um pedido pertence a um único usuário.
  user      User        @relation(fields: [userId], references: [id])
  userId    String      // Chave estrangeira para o modelo User.

  // Relação: Um pedido é composto por vários itens.
  items     OrderItem[]
}

// Modelo "OrderItem": Representa um item específico dentro de um pedido.
// Ex: 2 unidades do "Pastel de Queijo" dentro do Pedido #123.
model OrderItem {
  id        String  @id @default(uuid())
  quantity  Int     // Quantidade deste item no pedido.
  price     Float   // Preço do produto no momento da compra (para histórico).
  productName String @default("Produto Desconhecido") // Nome do produto no momento da compra.
  userName  String  @default("Usuário Desconhecido") // Nome do usuário que fez o pedido.

  // Relação: Este item de pedido pertence a um pedido (Order).
  order     Order   @relation(fields: [orderId], references: [id])
  orderId   String  // Chave estrangeira para o modelo Order.

  // Relação: Este item de pedido refere-se a um produto (Product).
  product   Product @relation(fields: [productId], references: [id])
  productId String  // Chave estrangeira para o modelo Product.
}